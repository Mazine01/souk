# Postgres connection string (local Docker, Neon, Supabase...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souk?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-64-random-hex-characters"
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# Set to "none" in production when client and API are on different domains
COOKIE_SAMESITE="lax"
# Optional: credentials for the seeded admin
SEED_ADMIN_EMAIL="admin@roster.dev"
SEED_ADMIN_PASSWORD="Roster!2026"
